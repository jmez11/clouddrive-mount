<Window x:Class="CloudDriveMount.App.Views.DriveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Drive"
        Width="680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#222222"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2D2D2D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,14,4" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,14,4" />
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444444" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#1E5E8A" />
            <Setter Property="BorderBrush" Value="#3B88C3" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2572A7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="22,18,22,20">
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,14">
                <TextBlock x:Name="DialogTitleText"
                           Text="New Drive"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#FFFFFF" />
                <TextBlock Text="Simplified Cloud &amp; NAS Mount Configuration"
                           HorizontalAlignment="Right"
                           Foreground="#9E9E9E"
                           FontSize="12" />
            </DockPanel>

            <!-- Storage Protocol Selector (All 5 in a single clean box) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Storage"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,10,12,0" />

                <Border Grid.Column="1"
                        Background="#1A1A1A"
                        BorderBrush="#555555"
                        BorderThickness="1"
                        Padding="8">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="ProtoSftpRadio"
                                     GroupName="StorageProto"
                                     Checked="OnProtocolSelectionChanged"
                                     Margin="4"
                                     Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgProtoSftp" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="SFTP" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ProtoFtpRadio"
                                     GroupName="StorageProto"
                                     Checked="OnProtocolSelectionChanged"
                                     Margin="4"
                                     Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgProtoFtp" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="FTP / FTPS" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ProtoWebDavRadio"
                                     GroupName="StorageProto"
                                     Checked="OnProtocolSelectionChanged"
                                     Margin="4"
                                     Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgProtoWebDav" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="WebDAV" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ProtoGDriveRadio"
                                     GroupName="StorageProto"
                                     Checked="OnProtocolSelectionChanged"
                                     Margin="4"
                                     Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgProtoGDrive" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="Google Drive" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ProtoR2Radio"
                                     GroupName="StorageProto"
                                     Checked="OnProtocolSelectionChanged"
                                     Margin="4"
                                     Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgProtoR2" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="Cloudflare R2" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>
            </Grid>

            <!-- Drive Letter & Label Row -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Drive"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           Margin="0,0,12,0" />

                <ComboBox x:Name="DriveLetterCombo"
                          Grid.Column="1"
                          Height="30"
                          Margin="0,0,8,0"
                          VerticalContentAlignment="Center" />

                <TextBox x:Name="DriveLabelBox"
                         Grid.Column="2"
                         Height="30"
                         ToolTip="Volume label shown next to the drive letter in Windows Explorer" />
            </Grid>

            <!-- Common Mount Options -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="95" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="175" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="ReconnectCheck"
                              Content="▶  Reconnect at program start"
                              IsChecked="True" />
                    <CheckBox x:Name="SignInEachCheck"
                              Content="👤  Sign in on each connection" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="LocalDiskCheck"
                                  Content="🖴  Local Disk"
                                  Checked="OnLocalDiskChanged"
                                  Unchecked="OnLocalDiskChanged" />
                        <RadioButton x:Name="PublicScopeRadio"
                                     Content="Public"
                                     GroupName="LocalDiskScopeGroup"
                                     IsChecked="True"
                                     Checked="OnLocalDiskChanged" />
                        <RadioButton x:Name="PrivateScopeRadio"
                                     Content="Private"
                                     GroupName="LocalDiskScopeGroup"
                                     Checked="OnLocalDiskChanged" />
                    </StackPanel>
                    <TextBlock x:Name="LanShareHintText"
                               Text="✓ Mounted in Global namespace — Windows Explorer 'Sharing' tab enabled (\\ComputerName\drive)"
                               Foreground="#81C784"
                               FontSize="11.5"
                               Margin="22,2,0,2"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <CheckBox x:Name="ProxyCheck"
                              Content="🌐  Proxy (cloudflared)"
                              Checked="OnProxyCheckChanged"
                              Unchecked="OnProxyCheckChanged" />
                    <CheckBox x:Name="ReadOnlyCheck"
                              Content="🔒  Read-only" />
                    <CheckBox x:Name="FileLockCheck"
                              Content="🅰  File Lock" />
                </StackPanel>
            </Grid>

            <!-- Native cloudflared Proxy Configuration Panel -->
            <Border x:Name="ProxyConfigPanel"
                    Background="#1B2631"
                    BorderBrush="#2E86C1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,10"
                    Margin="95,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Native Cloudflare Tunnel (cloudflared) Proxy"
                               FontWeight="SemiBold"
                               Foreground="#64B5F6"
                               Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Proxy Mode" Foreground="#B0BEC5" />
                        <ComboBox x:Name="ProxyModeCombo"
                                  Grid.Column="1"
                                  Height="28"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Auto-spawn cloudflared access tcp (--hostname → 127.0.0.1:port)" Tag="AccessTcpTunnel" />
                            <ComboBoxItem Content="Cloudflare Access Service Token Headers (CF-Access-Client-Id)" Tag="ServiceTokenHeaders" />
                            <ComboBoxItem Content="Both cloudflared access tcp + Service Token" Tag="BothAccessTcpAndHeaders" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tunnel Hostname" Foreground="#B0BEC5" />
                        <TextBox x:Name="CloudflaredHostnameBox"
                                 Grid.Column="1"
                                 ToolTip="Optional Cloudflare Access application hostname (defaults to Address host if left blank)" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Service Token" Foreground="#B0BEC5" />
                        <TextBox x:Name="CfClientIdBox"
                                 Grid.Column="1"
                                 ToolTip="CF-Access-Client-Id (optional)" />
                        <PasswordBox x:Name="CfClientSecretBox"
                                     Grid.Column="3"
                                     ToolTip="CF-Access-Client-Secret (optional)" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="cloudflared Path" Foreground="#B0BEC5" />
                        <TextBox x:Name="CloudflaredBinaryBox"
                                 Grid.Column="1"
                                 Text="cloudflared"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="2"
                                Content="Browse..."
                                Style="{StaticResource ActionBtn}"
                                Padding="8,4"
                                Click="OnBrowseCloudflaredClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PANEL 1: SFTP / FTP / WebDAV Configuration (Screenshot 3) -->
            <StackPanel x:Name="NasProtocolPanel">
                <!-- Address Row -->
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Address"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />

                    <CheckBox x:Name="UseTlsCheck"
                              Grid.Column="1"
                              Content="🛡"
                              ToolTip="Use TLS / SSL encryption"
                              IsChecked="True"
                              Checked="OnUseTlsChanged"
                              Unchecked="OnUseTlsChanged"
                              Margin="0,0,6,0" />

                    <TextBlock x:Name="SchemePrefixText"
                               Grid.Column="2"
                               Text="sftp://"
                               Foreground="#B0BEC5"
                               FontFamily="Consolas" />

                    <TextBox x:Name="HostBox"
                             Grid.Column="3"
                             ToolTip="Server hostname or IP (e.g. host.example.com)" />

                    <TextBlock Grid.Column="4"
                               Text=" : "
                               FontWeight="Bold" />

                    <TextBox x:Name="PortBox"
                             Grid.Column="5"
                             Text="22" />
                </Grid>

                <!-- Remote Path Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RemotePathBox"
                             Grid.Column="1"
                             Text="/"
                             ToolTip="Remote initial path (e.g. / or /home/user)" />
                </Grid>

                <!-- Account Row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Account"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />

                    <TextBox x:Name="UsernameBox"
                             Grid.Column="1"
                             ToolTip="Username" />

                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Column="3"
                                 ToolTip="Password" />

                    <CheckBox x:Name="AnonymousCheck"
                              Grid.Column="5"
                              Content="Anonymous"
                              Checked="OnAnonymousChanged"
                              Unchecked="OnAnonymousChanged"
                              Margin="0" />
                </Grid>

                <!-- SFTP SSH Private Key Row -->
                <Grid x:Name="SshKeyRow" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Private Key"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />

                    <TextBox x:Name="PrivateKeyPathBox"
                             Grid.Column="1"
                             Margin="0,0,6,0"
                             ToolTip="Optional OpenSSH/PuTTY private key file path" />

                    <Button Grid.Column="2"
                            Content="Browse..."
                            Style="{StaticResource ActionBtn}"
                            Padding="8,4"
                            Click="OnBrowsePrivateKeyClick" />

                    <PasswordBox x:Name="PrivateKeyPassphraseBox"
                                 Grid.Column="4"
                                 ToolTip="Optional Private Key Passphrase" />
                </Grid>

                <!-- SFTP Superuser Mode (sudo) Row -->
                <Grid x:Name="SftpSudoRow" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SftpSuperuserCheck"
                              Grid.Column="1"
                              Content="Superuser Mode (sudo)"
                              Margin="0,2,0,2" />
                </Grid>

                <!-- TLS/SSL & Timeout Row -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="TLS/SSL"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />

                    <ComboBox x:Name="TlsVersionCombo"
                              Grid.Column="1"
                              Height="28"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="TLS 1.2" Tag="Tls12" IsSelected="True" />
                        <ComboBoxItem Content="TLS 1.3" Tag="Tls13" />
                    </ComboBox>

                    <TextBlock Grid.Column="3"
                               Text="Timeout"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0" />

                    <TextBox x:Name="TimeoutBox"
                             Grid.Column="4"
                             Text="100"
                             HorizontalContentAlignment="Center" />

                    <TextBlock Grid.Column="5"
                               Text=" seconds"
                               Margin="4,0,0,0" />
                </Grid>
            </StackPanel>

            <!-- PANEL 2: Cloudflare R2 Configuration (Screenshot 1) -->
            <StackPanel x:Name="R2ProtocolPanel" Visibility="Collapsed">
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Account ID"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="R2AccountIdBox"
                             Grid.Column="1"
                             ToolTip="Cloudflare 32-character Account ID" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Access Key ID"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="R2AccessKeyIdBox"
                             Grid.Column="1"
                             ToolTip="R2 S3 API Access Key ID" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Secret Access Key"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <PasswordBox x:Name="R2SecretKeyBox"
                                 Grid.Column="1"
                                 ToolTip="R2 S3 API Secret Access Key" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bucket"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="R2BucketBox"
                             Grid.Column="1"
                             ToolTip="Type your R2 Bucket name directly, or click ↻ to discover/verify buckets" />
                    <Button x:Name="RefreshBucketsBtn"
                            Grid.Column="2"
                            Content="↻"
                            FontSize="15"
                            Style="{StaticResource ActionBtn}"
                            Padding="0"
                            Margin="6,0,0,0"
                            ToolTip="Discover Buckets or Verify Bucket Access"
                            Click="OnRefreshR2BucketsClick" />
                    <Border Grid.Column="3"
                            Background="#3E3E3E"
                            CornerRadius="11"
                            Padding="9,3"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="R2BucketCountText"
                                   Text="0"
                                   FontWeight="Bold"
                                   FontSize="12" />
                    </Border>
                </Grid>
            </StackPanel>

            <!-- PANEL 3: Google Drive Configuration (Screenshot 2) -->
            <StackPanel x:Name="GoogleDriveProtocolPanel" Visibility="Collapsed">
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Google Drive"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="GDriveMyDriveRadio"
                                     Content="My Drive"
                                     GroupName="GDriveScope"
                                     IsChecked="True"
                                     Checked="OnGoogleScopeChanged" />
                        <RadioButton x:Name="GDriveSharedRadio"
                                     Content="Shared with me"
                                     GroupName="GDriveScope"
                                     Checked="OnGoogleScopeChanged" />
                        <RadioButton x:Name="GDriveFolderRadio"
                                     Content="Folder"
                                     GroupName="GDriveScope"
                                     Checked="OnGoogleScopeChanged" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="GDriveFolderIdRow" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folder ID"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="GDriveFolderIdBox"
                             Grid.Column="1"
                             ToolTip="Google Drive Folder ID from URL" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="95" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="OAuth Client"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <TextBox x:Name="GDriveClientIdBox"
                             Grid.Column="1"
                             ToolTip="Google Cloud OAuth 2.0 Desktop Client ID (*.apps.googleusercontent.com)" />
                    <PasswordBox x:Name="GDriveClientSecretBox"
                                 Grid.Column="3"
                                 ToolTip="Google Cloud OAuth 2.0 Client Secret (GOCSPX-...)" />
                    <Button Grid.Column="5"
                            Content="Import JSON"
                            Style="{StaticResource ActionBtn}"
                            Padding="6,5"
                            ToolTip="Import client_secret_*.json downloaded from Google Cloud Console"
                            Click="OnImportGoogleClientJsonClick" />
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Access / Refresh"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0" />
                    <PasswordBox x:Name="GDriveTokenBox"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 ToolTip="OAuth Refresh Token or Access Token (populated automatically when signing in)" />
                    <Button Grid.Column="2"
                            Content="Sign in with Google..."
                            Style="{StaticResource ActionBtn}"
                            Padding="10,5"
                            Click="OnGoogleOAuthSignInClick" />
                </Grid>
            </StackPanel>

            <!-- Status / Validation Message -->
            <TextBlock x:Name="ValidationStatusText"
                       Foreground="#EF9A9A"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="95,8,0,0"
                       Visibility="Collapsed" />

            <!-- Bottom Action Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="ConnectNowBtn"
                        Content="Connect"
                        Width="105"
                        Style="{StaticResource PrimaryBtn}"
                        Margin="0,0,8,0"
                        Click="OnConnectNowClick" />
                <Button Content="Save Only"
                        Width="100"
                        Style="{StaticResource ActionBtn}"
                        Margin="0,0,8,0"
                        Click="OnSaveOnlyClick" />
                <Button Content="Cancel"
                        Width="95"
                        Style="{StaticResource ActionBtn}"
                        IsCancel="True"
                        Click="OnCancelClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
