<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.1.11</Version>
    <Company>Oceanside-VR</Company>
    <Product>CloudDrive Mount for Windows</Product>
    <AssemblyTitle>CloudDrive Mount</AssemblyTitle>
    <Description>CloudDrive Mount virtual filesystem client for Windows</Description>
    <Copyright>Copyright © 2026 Oceanside-VR</Copyright>
    <Authors>Oceanside-VR</Authors>
    <AssemblyName>CloudDriveMount</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudDriveMount.Core\CloudDriveMount.Core.csproj" />
  </ItemGroup>

</Project>
